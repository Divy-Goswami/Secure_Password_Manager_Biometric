# Production Environment Variables Template
# Copy this file and set actual values for deployment

# Django Settings
DJANGO_SECRET_KEY=your-secret-key-here-generate-a-strong-random-key
DEBUG=False
ALLOWED_HOSTS=.railway.app,.vercel.app,localhost

# Database (provided by Railway/Render automatically)
DATABASE_URL=postgresql://user:password@host:port/dbname

# CORS Settings (add your frontend URL)
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000

# Email Settings (optional - for password reset, etc.)
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-specific-password

# Frontend URL (for email links, etc.)
FRONTEND_URL=https://your-frontend.vercel.app
